# Copia este archivo como .env.local y llena los valores de tu proyecto Supabase
# (Supabase > Project Settings > API). La clave "publishable" es segura en el navegador:
# la protección real la hace Row Level Security en la base de datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
